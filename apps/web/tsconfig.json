{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@kairo/core": ["../../packages/core/src/index.ts"],
      "@kairo/core/*": ["../../packages/core/src/*"],
      "@kairo/api": ["../../packages/api/src/index.ts"],
      "@kairo/api/*": ["../../packages/api/src/*"],
      "@kairo/platform": ["../../packages/platform/src/index.ts"],
      "@kairo/platform/*": ["../../packages/platform/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist"]
}
