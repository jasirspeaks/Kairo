{
  "expo": {
    "name": "Kairo",
    "slug": "kairo",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "kairo",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.kairo.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kairo needs microphone access to record and analyze sales conversations."
      }
    },
    "android": {
      "package": "com.kairo.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [],
    "experiments": {
      "typedRoutes": true
    }
  }
}
